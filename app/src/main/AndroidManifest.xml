<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Temporarily disabled for dev
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    -->

    <application
        android:name=".OpoleyesApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="OpoLeyes"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Opoleyes"
        android:screenOrientation="portrait"
        tools:targetApi="31">

        <!-- Temporarily disabled for dev
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3940256099942544~3347511713" />
        -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Opoleyes.Splash" />

        <!-- Launcher alias: OL Variant 1 (Indigo) — disabled, turquesa is default -->
        <activity-alias
            android:name=".OlV1Alias"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_ol_v1"
            android:label="OpoLeyes"
            android:roundIcon="@mipmap/ic_launcher_ol_v1_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Launcher alias: OL Variant 2 (Gold) -->
        <activity-alias
            android:name=".OlV2Alias"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_ol_v2"
            android:label="OpoLeyes"
            android:roundIcon="@mipmap/ic_launcher_ol_v2_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Launcher alias: OL Variant 3 (Teal) — default launcher -->
        <activity-alias
            android:name=".OlV3Alias"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_ol_v3"
            android:label="OpoLeyes"
            android:roundIcon="@mipmap/ic_launcher_ol_v3_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
