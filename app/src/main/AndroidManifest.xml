<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:name=".OpoleyesApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher_ol_v3"
        android:label="OpoLeyes"
        android:roundIcon="@mipmap/ic_launcher_ol_v3_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Opoleyes"
        android:screenOrientation="fullUser"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Opoleyes.Splash" />

        <!-- Launcher alias: OL Variant 3 (Teal) — default launcher -->
        <activity-alias
            android:name=".OlV3Alias"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_ol_v3"
            android:label="OpoLeyes"
            android:roundIcon="@mipmap/ic_launcher_ol_v3_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
